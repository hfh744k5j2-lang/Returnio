// ObalBook – sdílená evidence vratných obalů mezi firmami.
// Zásada: nic se nemaže. Změny se zapisují jako nové záznamy / změny stavu + AuditLog.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  LOGISTIK
  SKLAD
}

enum Currency {
  CZK
  EUR
}

enum PartnershipStatus {
  PENDING // pozvánka odeslána, partner se zatím nezaregistroval
  ACTIVE // partner je registrovaná firma
}

/// Strana partnerství. A = firma, která partnera pozvala, B = pozvaný partner.
enum Side {
  A
  B
}

enum MovementKind {
  ISSUE // výdej
  RECEIPT // příjem
  RETURN // vrácení
  LOSS // ztráta
  DAMAGE // poškození
  CORRECTION // oprava
}

enum MovementStatus {
  PROPOSED // navržen
  CONFIRMED // potvrzen
  DISPUTED // rozporován
  CANCELLED // zrušen autorem před potvrzením (zůstává v historii)
}

enum CorrectionStatus {
  OPEN
  ACCEPTED
  SUPERSEDED
}

// ---------- Auth.js ----------

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  locale        String     @default("cs")
  companyId     String?
  company       Company?   @relation(fields: [companyId], references: [id])
  role          Role?
  createdAt     DateTime   @default(now())
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]

  @@index([companyId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Firmy ----------

model Company {
  id                 String             @id @default(cuid())
  name               String
  regNumber          String? // IČO / NIP / IČ DPH
  country            String             @default("CZ")
  address            String?
  /// Upozornit, když celkové saldo s jedním partnerem (v kusech, v absolutní hodnotě) přesáhne limit.
  balanceAlertLimit  Int?
  createdAt          DateTime           @default(now())
  users              User[]
  invitations        Invitation[]
  packagingTypes     PackagingType[]
  partnershipsAsA    Partnership[]      @relation("PartnershipA")
  partnershipsAsB    Partnership[]      @relation("PartnershipB")
}

model Invitation {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  email      String
  role       Role
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  createdById String?

  @@index([companyId])
}

// ---------- Partneři ----------

model Partnership {
  id               String            @id @default(cuid())
  companyAId       String
  companyA         Company           @relation("PartnershipA", fields: [companyAId], references: [id])
  companyBId       String?
  companyB         Company?          @relation("PartnershipB", fields: [companyBId], references: [id])
  /// Název a e-mail partnera, jak je zadala firma A (používá se, dokud se B nezaregistruje).
  invitedName      String
  invitedEmail     String
  status           PartnershipStatus @default(PENDING)
  inviteTokenHash  String?           @unique
  inviteExpiresAt  DateTime?
  /// Krátký kód partnera pro QR a import (unikátní v rámci firmy A).
  code             String
  /// Kód, pod kterým partnera vede firma B (volitelně), pro QR na straně B.
  codeB            String?
  createdAt        DateTime          @default(now())
  activatedAt      DateTime?
  movements        Movement[]
  partnerLinks     PartnerLinkToken[]

  @@unique([companyAId, code])
  @@index([companyBId])
}

// ---------- Typy obalů ----------

model PackagingType {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id])
  name        String
  code        String
  material    String?
  weightKg    Decimal        @db.Decimal(10, 3)
  deposit     Decimal?       @db.Decimal(12, 2)
  currency    Currency       @default(CZK)
  reusable    Boolean        @default(true)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  lines       MovementLine[]

  @@unique([companyId, code])
}

// ---------- Pohyby ----------

model Movement {
  id              String               @id @default(cuid())
  /// Pořadové číslo pohybu v rámci partnerství (P-000123). Číslování není globální, aby neprozrazovalo objem jiných firem.
  number          Int
  partnershipId   String
  partnership     Partnership          @relation(fields: [partnershipId], references: [id])
  kind            MovementKind
  /// Kdo pohyb zapsal (A nebo B). Druhá strana potvrzuje.
  createdBySide   Side
  /// Směr toku obalů: A_TO_B => obaly odešly od A k B (B dluží A).
  fromSide        Side
  date            DateTime             @db.Date
  deliveryNote    String?
  note            String?
  status          MovementStatus       @default(PROPOSED)
  createdById     String?
  createdAt       DateTime             @default(now())
  confirmedAt     DateTime?
  confirmedById   String?
  /// Potvrzení přes jednorázový odkaz – jméno, které zadal partner.
  confirmedByLabel String?
  importBatchId   String?
  lines           MovementLine[]
  corrections     MovementCorrection[]
  partnerLinks    PartnerLinkToken[]

  @@unique([partnershipId, number])
  @@index([partnershipId, status])
  @@index([date])
}

model MovementLine {
  id              String        @id @default(cuid())
  movementId      String
  movement        Movement      @relation(fields: [movementId], references: [id])
  packagingTypeId String
  packagingType   PackagingType @relation(fields: [packagingTypeId], references: [id])
  /// Snímek vlastností typu v okamžiku zápisu – výkaz PPWR se zpětně nemění při úpravě typu.
  weightKg        Decimal       @db.Decimal(10, 3)
  reusable        Boolean
  /// Počet navržený autorem.
  quantity        Int
  /// Počet platný po potvrzení (případně po vyřešení rozporu). Saldo počítá s tímto číslem.
  finalQuantity   Int?

  @@unique([movementId, packagingTypeId])
}

/// Rozpor / návrh opravy. Pohyb je potvrzen, až druhá strana návrh přijme.
model MovementCorrection {
  id             String           @id @default(cuid())
  movementId     String
  movement       Movement         @relation(fields: [movementId], references: [id])
  proposedBySide Side
  proposedById   String?
  proposedByLabel String?
  reason         String
  /// [{ packagingTypeId, quantity }]
  lines          Json
  status         CorrectionStatus @default(OPEN)
  createdAt      DateTime         @default(now())
  decidedAt      DateTime?
  decidedById    String?
  decidedByLabel String?

  @@index([movementId])
}

/// Jednorázový odkaz pro partnera bez registrace (potvrzení nebo rozporování jednoho pohybu).
model PartnerLinkToken {
  id            String      @id @default(cuid())
  tokenHash     String      @unique
  partnershipId String
  partnership   Partnership @relation(fields: [partnershipId], references: [id])
  movementId    String
  movement      Movement    @relation(fields: [movementId], references: [id])
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())
}

// ---------- Import ----------

model ImportBatch {
  id          String   @id @default(cuid())
  companyId   String
  createdById String?
  fileName    String
  rowCount    Int
  movementCount Int
  createdAt   DateTime @default(now())

  @@index([companyId])
}

// ---------- Audit a upozornění ----------

/// Auditní stopa. Pouze INSERT – aplikace záznamy nikdy nemění ani nemaže.
model AuditLog {
  id            String   @id @default(cuid())
  companyId     String?
  partnershipId String?
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  /// Pro akce přes jednorázový odkaz (bez uživatele).
  actorLabel    String?
  action        String
  entityType    String
  entityId      String
  data          Json?
  createdAt     DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([partnershipId, createdAt])
  @@index([entityType, entityId])
}

/// Zabraňuje opakovanému odeslání stejného upozornění.
model NotificationLog {
  id        String   @id @default(cuid())
  key       String   @unique
  companyId String?
  kind      String
  sentTo    String
  createdAt DateTime @default(now())
}

/// Odeslané e-maily v dev/test režimu (bez SMTP/Resend). V produkci se nepoužívá.
model DevEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  text      String
  createdAt DateTime @default(now())

  @@index([to, createdAt])
}
