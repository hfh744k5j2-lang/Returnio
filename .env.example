# Databáze (lokálně docker compose up -d). V produkci Supabase EU / Neon EU connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/obalbook"
# Pro Supabase s poolerem: DIRECT_URL pro migrace (jinak stejné jako DATABASE_URL)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/obalbook"

# Auth.js – vygenerujte: openssl rand -base64 32
AUTH_SECRET="change-me"
# Veřejná adresa aplikace (odkazy v e-mailech)
APP_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# E-maily: bez nastavení se vypisují do konzole (dev režim).
# Varianta A – Resend:
# RESEND_API_KEY=""
# Varianta B – SMTP (např. smtp://user:pass@smtp.example.com:587):
# SMTP_URL=""
EMAIL_FROM="ObalBook <noreply@example.com>"

# Ochrana endpointu /api/cron/notifications (Vercel Cron posílá Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="change-me-too"
